# ========================================================
# MEU TAROT MOBILE - Configurações do Firebase
# ========================================================
# No Expo, variáveis que começam com EXPO_PUBLIC_ são expostas
# automaticamente para o código do app sem necessidade de plugins extras.
#
# ATENÇÃO: NUNCA commite suas chaves reais no repositório.
# Crie um arquivo .env nesta pasta mobile/ com suas credenciais.

EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_firebase_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
EXPO_PUBLIC_FIREBASE_DATABASE_ID=your_database_id
EXPO_PUBLIC_FIREBASE_HOSTING_URL=https://your_project.web.app

# Google OAuth Web Client ID (necessário para build nativo mobile com @react-native-google-signin)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_google_web_client_id_here
